{
  "name": "@kalisio/feathers-mongodb-management",
  "description": "Manage MongoDB Databases, Users & Collections with this Feathers service adapter",
  "version": "3.1.0",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.js",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "standard": {
    "ignore": [
      "dist/**"
    ]
  },
  "scripts": {
    "build": "vite build",
    "postbuild": "publint",
    "lint": "standard --fix",
    "test": "vitest run  --coverage"
  },
  "keywords": [
    "kalisio"
  ],
  "author": {
    "name": "Kalisio",
    "email": "contact@kalisio.com",
    "url": "https://github.com/kalisio"
  },
  "contributors": [],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kalisio/feathers-ekosystem.git",
    "directory": "packages/feathers-mongodb-management"
  },
  "bugs": {
    "url": "https://github.com/kalisio/feathers-ekosystem/issues"
  },
  "homepage": "https://github.com/kalisio/feathers-ekosystem/tree/main/packages/feathers-mongodb-management",
  "dependencies": {
    "debug": "catalog:",
    "sift": "catalog:"
  },
  "devDependencies": {
    "mongodb": "catalog:"
  },
  "peerDependencies": {
    "@feathersjs/adapter-commons": "catalog:",
    "@feathersjs/commons": "catalog:",
    "@feathersjs/errors": "catalog:",
    "@feathersjs/feathers": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs"
      }
    }
  }
}